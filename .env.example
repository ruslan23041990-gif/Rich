# Bybit API Configuration
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=False

# Trading Configuration
TRADING_PAIR=BTCUSDT
LEVERAGE=5
POSITION_SIZE=100
MAX_POSITIONS=3

# Risk Management
STOP_LOSS_PERCENT=2
TAKE_PROFIT_PERCENT=4
